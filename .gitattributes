* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

*.java text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.nsi text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.docx binary
*.jar binary
*.apk binary
*.exe binary

# Preserve archived sources exactly, including their historical whitespace.
docs/legacy/** -text -whitespace
